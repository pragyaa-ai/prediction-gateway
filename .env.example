# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Local model files directory (optional)
# Default: <repo>/models/local-models
# Set this if models are deployed outside the repo, e.g. /opt/ml-models
# LOCAL_MODELS_DIR=/opt/ml-models

# OpenSearch Configuration
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=Adm!9Kq7Zx@42
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
# One index per model, e.g. ml-predictions-no-show-fakeeh-ksa-local
OPENSEARCH_INDEX_PREFIX=ml-predictions

# Azure ML Configuration (Optional - can use API keys in models.yaml)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Admin UI (Optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
